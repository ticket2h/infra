# Secret của cả hệ thống Ticket2h khi chạy local. docker compose (profile apps) đọc file .env này và đưa cho mỗi
# container những biến nó cần; service chạy bằng ./mvnw đọc ../infra/.env (tính từ thư mục của service).
# Tạo nhanh với giá trị ngẫu nhiên: scripts/init-env.sh
# KHÔNG commit file .env (đã có trong .gitignore).

# core-service ↔ mock-payment-gateway: khoá API merchant và secret ký webhook (hai bên phải dùng CÙNG giá trị)
MOCKPAY_API_KEY=
MOCKPAY_WEBHOOK_SECRET=


# core-service: khoá Ed25519 ký QR vé, base64 (xem ADR-008 của core-service)
QR_PRIVATE_KEY=
QR_PUBLIC_KEY=

# identity-service: private key ký JWT (RSA 2048, PKCS#8 DER, base64 một dòng). Chỉ identity đọc biến này;
# service khác lấy public key qua http://localhost:8082/.well-known/jwks.json
JWT_PRIVATE_KEY=

# Khoá gọi API nội bộ /internal/**, mỗi service GỌI có một khoá (tối thiểu 32 ký tự):
# notification-service gọi core-service và identity-service
INTERNAL_API_KEY_NOTIFICATION=
# core-service gọi identity-service
INTERNAL_API_KEY_CORE=
